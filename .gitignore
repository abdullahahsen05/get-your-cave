# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# uploaded verification documents
/public/uploads/verification-documents/*
!/public/uploads/verification-documents/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev logs
dev-server.log
*.log

# generated contract documents (runtime artifacts)
/docs/generated/

# BoldSign runtime artifacts (signed PDFs and audit trails)
/docs/signed/
/docs/audit/

# uploaded booking documents (runtime uploads)
/public/uploads/booking-documents/*
!/public/uploads/booking-documents/.gitkeep

# Claude Code local settings
.claude/settings.local.json
